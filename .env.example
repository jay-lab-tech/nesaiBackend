APP_NAME=NESAS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nesas
DB_USERNAME=postgres
DB_PASSWORD=

FRONTEND_URL=http://localhost:3000
# Origin frontend yang diizinkan memanggil endpoint chat (dipisah koma). WAJIB di-set
# eksplisit di production (contoh: https://smkn1subang.sch.id,https://www.smkn1subang.sch.id).
CHAT_TRUSTED_ORIGINS=http://localhost:3000
LLM_API_KEY=
LLM_MODEL=
CHAT_HISTORY_LIMIT=20
CHAT_STORED_MESSAGES_LIMIT=100
CHAT_PROVIDER_TIMEOUT=10
CHAT_RETENTION_DAYS=90
# Fast-path: jawab intent umum dari database tanpa memanggil Gemini (true/false).
CHAT_FASTPATH_ENABLED=true
# Circuit breaker ke Gemini: buka circuit setelah N kegagalan berturut dalam jendela detik.
CHAT_CIRCUIT_FAIL_THRESHOLD=5
CHAT_CIRCUIT_FAIL_WINDOW=60
CHAT_CIRCUIT_OPEN_SECONDS=60
# Batas request serentak ke Gemini (kelebihan request dilewati ke fast-path/fallback).
CHAT_MAX_CONCURRENCY=3
CHAT_CONCURRENCY_LOCK_SECONDS=15
# Rate limit (per menit). Chat dibatasi per-IP + plafon global untuk melindungi kuota AI.
CHAT_RATE_LIMIT_PER_IP=60
CHAT_RATE_LIMIT_GLOBAL=120
CHAT_RATE_LIMIT_SEARCH=30
CHAT_RATE_LIMIT_RECOMMENDATIONS=20
# Jendela detik untuk men-dedup pesan identik (anti double-submit / retry).
CHAT_IDEMPOTENCY_SECONDS=5
CHAT_PRUNE_BATCH_LIMIT=50

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
